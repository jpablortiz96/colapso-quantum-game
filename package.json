{
  "name": "colapso",
  "version": "0.0.0",
  "private": true,
  "description": "Deterministic quantum puzzle game built from preserved IBM Quantum evidence",
  "packageManager": "npm@11.8.0",
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "lint": "npm run lint --workspace frontend",
    "test": "npm run test --workspace frontend",
    "build": "npm run build --workspace frontend",
    "scan:secrets": "node scripts/verify-step0.mjs --secrets-only",
    "verify:step0": "node scripts/verify-step0.mjs",
    "verify:f1": "node scripts/verify-f1.mjs",
    "verify:f2a": "node scripts/verify-f2a.mjs",
    "verify:f2b": "node scripts/verify-f2b.mjs",
    "acquire:campaign-quantum-evidence": "powershell -NoProfile -ExecutionPolicy Bypass -File backend/scripts/run_campaign_acquisition.ps1",
    "finalize:campaign-evidence": "uv run --frozen --directory backend python scripts/acquire_campaign_quantum_evidence.py --finalize-offline",
    "verify:campaign-evidence": "uv run --frozen --directory backend python scripts/acquire_campaign_quantum_evidence.py --verify-offline",
    "check:backend": "uv run --frozen --directory backend ruff check . && uv run --frozen --directory backend pytest",
    "universe:build": "jiti frontend/src/daily-universe/cli.ts build",
    "universe:verify": "jiti frontend/src/daily-universe/cli.ts verify",
    "campaign:build": "jiti frontend/src/daily-universe/cli.ts campaign-build",
    "campaign:finalize": "jiti frontend/src/daily-universe/cli.ts campaign-finalize",
    "campaign:verify": "jiti frontend/src/daily-universe/cli.ts campaign-verify",
    "verify:f3": "node scripts/verify-f3.mjs",
    "universe:sync-f4a": "node scripts/sync-f4a-universe.mjs",
    "verify:f4a": "node scripts/verify-f4a.mjs",
    "verify:production": "node scripts/verify-production.mjs",
    "verify:media": "node scripts/verify-public-media.mjs",
    "verify:public-repo": "node scripts/verify-public-repository.mjs && npm run verify:media",
    "capture:screenshots": "node scripts/capture-production-screenshots.mjs",
    "verify:amplify-package": "node scripts/verify-amplify-package.mjs && node --test scripts/verify-amplify-package.test.mjs",
    "release:prepare-offline": "npm run verify:campaign-evidence && npm run campaign:verify && node scripts/sync-f4a-universe.mjs --check && npm run check:backend && npm run lint && npm run test && npm run build && npm run verify:f2b && npm run verify:f3 && npm run verify:f4a && npm run verify:production && npm run verify:media && npm run verify:amplify-package && npm run verify:public-repo && npm run scan:secrets && git diff --check",
    "release:finalize-offline": "npm run finalize:campaign-evidence && npm run campaign:finalize && npm run release:prepare-offline",
    "analyze:v2-difficulty": "jiti scripts/analyze-v2-difficulty.ts",
    "playtest:v2": "npm run test --workspace frontend -- src/playtest-v2.test.tsx",
    "check": "npm run lint && npm run test && npm run build && npm run verify:step0 && npm run verify:f1"
  },
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  }
}
